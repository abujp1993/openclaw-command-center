{
  "name": "openclaw",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw - Personal Assistant Command Center",
  "author": "OpenClaw Team",
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck",
    "package": "turbo run package",
    "package:win": "turbo run package:win",
    "package:mac": "turbo run package:mac",
    "package:linux": "turbo run package:linux"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "prettier": "^3.1.0",
    "eslint": "^8.55.0"
  },
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
